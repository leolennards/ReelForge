# ReelForge local engine settings. Copy to `.env` or export these in your shell
# before `npm run dev`. Every value is optional; the defaults are shown.
# Paths separated by ":" on macOS/Linux and ";" on Windows.

# Address the engine listens on. Keep it on 127.0.0.1 (this computer only).
REELFORGE_HOST=127.0.0.1
REELFORGE_PORT=8765

# Web interfaces allowed to call the engine (comma-separated).
REELFORGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Folders the "Browse library" dialog may read movies from.
# Default: ~/Movies, ~/Videos, ~/Downloads and ~/Desktop (those that exist).
# REELFORGE_MEDIA_DIRS=/Users/you/Movies:/Users/you/Downloads

# Folders converted movies may be written into (and their subfolders). Default: your home folder.
# REELFORGE_OUTPUT_ROOTS=/Users/you
# Default output folder. Default: ~/Movies/ReelForge (or ~/Videos/ReelForge).
# REELFORGE_OUTPUT_DIR=/Users/you/Movies/ReelForge

# Where the database, logs and drag-and-drop imports are kept.
# Default: ~/Library/Application Support/ReelForge (macOS), %LOCALAPPDATA%\ReelForge (Windows).
# REELFORGE_DATA_DIR=

# Limits
REELFORGE_MAX_UPLOAD_GB=100
REELFORGE_MIN_FREE_GB=1
REELFORGE_JOB_TIMEOUT_HOURS=12
REELFORGE_STALL_TIMEOUT_MINUTES=10

# Use specific FFmpeg/FFprobe binaries instead of the ones on PATH.
# REELFORGE_FFMPEG_PATH=
# REELFORGE_FFPROBE_PATH=

# Only set this if you understand that anyone on your network could reach the engine.
# REELFORGE_ALLOW_REMOTE=0
